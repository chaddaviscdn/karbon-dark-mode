{
  "manifest_version": 3,
  "name": "Karbon Dark Mode",
  "version": "1.3.4",
  "description": "A dark mode toggle for Karbon (app2.karbonhq.com). Uniform dark theme across the whole app, including email bodies.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Karbon Dark Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app2.karbonhq.com/*",
        "https://app.karbonhq.com/*"
      ],
      "js": ["content.js"],
      "css": ["dark.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://app2.karbonhq.com/*"],
      "js": ["toplayer.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
